# === S3 Credentials ===
# For local dev with RustFS, you can use rustfsadmin/rustfsadmin (dev-only, safe for local).
# For production AWS, set real credentials and uncomment the AWS endpoint.
# NEVER commit real credentials - keep .env ignored (see .gitignore).
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_ENDPOINT=http://rustfs:9000
# S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1

# === Buckets ===
JUICE_BUCKET=juicefs-blockchain
CLICKHOUSE_BUCKET=clickhouse-storage

# === Valkey ===
VALKEY_PASSWORD=changeme  # set strong password for production

# === Bitcoin Knots ===
BITCOIN_RPC_USER=bitcoin
BITCOIN_RPC_PASSWORD=changeme  # set strong password for production

# === ClickHouse ===
CLICKHOUSE_USER=bitcoin
CLICKHOUSE_PASSWORD=changeme  # set strong password for production; required by docker-compose.prod.yml
