# === S3 Credentials ===
# For local dev with RustFS, you can use rustfsadmin/rustfsadmin (dev-only, safe for local).
# For production AWS, set real credentials and uncomment the AWS endpoint.
# NEVER commit real credentials - keep .env ignored (see .gitignore).
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_ENDPOINT=http://rustfs:9000
# S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1

# === Buckets ===
JUICE_BUCKET=juicefs-blockchain
CLICKHOUSE_BUCKET=clickhouse-storage

# === Valkey ===
VALKEY_PASSWORD=changeme  # set strong password for production

# === Bitcoin Knots ===
BITCOIN_RPC_USER=bitcoin
BITCOIN_RPC_PASSWORD=changeme  # set strong password for production

# === ClickHouse ===
CLICKHOUSE_USER=bitcoin
CLICKHOUSE_PASSWORD=changeme  # set strong password for production; required by docker-compose.prod.yml

# === Auth (JWT / OAuth / Nostr) ===
# NEVER commit real secrets — values below are dev placeholders only.
# Prod JWT_SECRET must be >=32 bytes (short keys trip InsecureKeyLengthWarning).
JWT_SECRET=changeme-dev-secret
JWT_EXPIRE_MIN=60
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:8000
# Nostr challenge TTL seconds (backend/app/auth/challenge_store.py, default 300).
NOSTR_CHALLENGE_TTL=300
# OAuth state store TTL is 600s hardcoded (backend/app/auth/oauth_state_store.py).
# Pinned social-auth-core version actually installed in backend/.venv:
SOCIAL_CORE_PIN=social-auth-core==5.1.1
# coincurve (BIP-340 Schnorr for Nostr verify): coincurve==21.0.0
# NOTE (prod): challenge + OAuth state stores are in-memory with Valkey
# fallback-attempt in challenge_store; multi-replica prod needs reachable
# VALKEY_URL (valkey://...) so challenge/state is shared across instances.
