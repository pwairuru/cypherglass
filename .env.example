# === S3 Credentials ===
# For local dev with RustFS, you can use rustfsadmin/rustfsadmin (dev-only, safe for local).
# For production AWS, set real credentials and uncomment the AWS endpoint.
# NEVER commit real credentials - keep .env ignored (see .gitignore).
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_ENDPOINT=http://rustfs:9000
# S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1

# === Buckets ===
JUICE_BUCKET=juicefs-blockchain
CLICKHOUSE_BUCKET=clickhouse-storage

# === Data root (host path for bind mounts) ===
# Local dev default is ./volumes; set to /run/media/wairuru/filos/cypherglass-volumes
# to keep bulk data (rustfs/clickhouse/pg) off the root disk.
DATA_ROOT=./volumes

# === Postgres (dev defaults are localhost-only via 127.0.0.1 port binding) ===
# Prod: set strong POSTGRES_PASSWORD in .env; compose reads these.
POSTGRES_USER=cypher
POSTGRES_PASSWORD=cypher
POSTGRES_DB=cypher

# === Valkey ===
VALKEY_PASSWORD=changeme  # set strong password for production

# === Bitcoin Knots ===
BITCOIN_RPC_USER=bitcoin
BITCOIN_RPC_PASSWORD=changeme  # set strong password for production

# === ClickHouse ===
CLICKHOUSE_USER=bitcoin
CLICKHOUSE_PASSWORD=changeme  # set strong password for production; required by docker-compose.prod.yml

# === Auth (JWT / OAuth / Nostr) ===
# NEVER commit real secrets — values below are dev placeholders only.
# Prod JWT_SECRET must be >=32 bytes and random (openssl rand -hex 32).
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-not-for-prod-0123456789abcdef0123456789abcdef01234567
JWT_EXPIRE_MIN=60
# Comma-separated CORS allowlist (backend-rs/src/config.rs CORS_ORIGINS).
CORS_ORIGINS=http://localhost:5173,http://localhost:8002
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:8002
# NOTE (prod): Nostr challenge + OAuth state stores are in-memory with a
# Valkey fallback in backend-rs/src/store.rs; multi-replica prod needs a
# reachable VALKEY_URL (valkey://...) so challenge/state is shared.
