# Rust decoder (musl static) + Bitcoin Core + JuiceFS all-in-one.
# Build context: repo root (compose: context: ., dockerfile: juicefs/Dockerfile.allinone).
FROM rust:alpine AS decoder-builder
RUN apk add --no-cache musl-dev
WORKDIR /src
COPY decoder/Cargo.toml decoder/Cargo.lock ./
COPY decoder/src ./src
RUN cargo build --release --locked
RUN strip target/release/decoder

FROM alpine:3.20 AS builder
COPY juicefs/juicefs-bin /usr/local/bin/juicefs
COPY --from=decoder-builder /src/target/release/decoder /usr/local/bin/decoder
RUN chmod +x /usr/local/bin/juicefs /usr/local/bin/decoder

FROM ruimarinho/bitcoin-core:latest
COPY --from=builder /usr/local/bin/juicefs /usr/local/bin/juicefs
COPY --from=builder /usr/local/bin/decoder /usr/local/bin/decoder
RUN apt-get update && apt-get install -y fuse3 && rm -rf /var/lib/apt/lists/*
COPY juicefs/entrypoint-allinone.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bitcoind"]
